#pragma once
// Copy this file to "secrets.h" (same folder) and fill in your Wi-Fi
// credentials. secrets.h is gitignored so your password never gets committed.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Optional: set a static hostname so the dashboard is reachable at
// http://esp32-powermeter.local/ (mDNS) instead of hunting for its IP.
#define DEVICE_HOSTNAME "esp32-powermeter"
